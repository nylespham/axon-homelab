# Terraform Variables Example
# Copy this file to terraform.tfvars and customize for your needs

# Basic configuration
aws_region     = "us-west-2"
cluster_name   = "eks-interview-lab"
cluster_version = "1.32"

# Who may reach the public EKS API (your public IP: curl -s https://checkip.amazonaws.com)
api_allowed_cidrs = ["203.0.113.10/32"]

# Node configuration
node_instance_type     = "t3.small"  # Options: t3.small, t3.medium, t3.large
node_desired_capacity  = 1           # Number of nodes
node_max_capacity      = 3           # Maximum nodes for scaling
use_spot_instances     = false       # Use Spot instances (can be interrupted)

# Configuration examples:
# For minimal resources:
# node_instance_type = "t3.small"
# node_desired_capacity = 1
# use_spot_instances = true

# For better performance:
# node_instance_type = "t3.medium"
# node_desired_capacity = 2
# use_spot_instances = false
